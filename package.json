{
  "name": "gptbash",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "add-quote": "tsx scripts/add-quote.ts",
    "lint": "oxlint src scripts --import-plugin --promise-plugin --jsx-a11y-plugin",
    "lint:fix": "oxlint src scripts --import-plugin --promise-plugin --jsx-a11y-plugin --fix",
    "lighthouse": "lighthouse http://localhost:4321 --view --preset=desktop",
    "lighthouse:mobile": "lighthouse http://localhost:4321 --view --preset=mobile",
    "lighthouse:full": "lighthouse http://localhost:4321 --output=html --output-path=./lighthouse-report.html --preset=desktop",
    "lighthouse:all": "lighthouse http://localhost:4321 --output=html --output=json --output-path=./lighthouse-report --only-categories=performance,accessibility,best-practices,seo"
  },
  "dependencies": {
    "@astrojs/partytown": "^2.1.4",
    "@astrojs/preact": "^4.1.3",
    "@playform/compress": "^0.2.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.1.18",
    "@vercel/og": "^0.8.6",
    "astro": "^5.17.1",
    "astro-compressor": "^1.2.0",
    "preact": "^10.28.2",
    "satori": "^0.19.1",
    "sharp": "^0.34.5",
    "sonda": "^0.10.1",
    "tailwindcss": "^4.1.18",
    "uuid": "^13.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/uuid": "^10.0.0",
    "lighthouse": "^13.0.1",
    "oxlint": "^1.42.0",
    "tsx": "^4.21.0"
  }
}
