{
  "name": "gptbash-generator",
  "version": "1.0.0",
  "type": "module",
  "description": "Bash.org.pl style quote generator using Mastra AI workflows",
  "scripts": {
    "dev": "mastra dev",
    "start": "tsx src/cli.ts",
    "start:verbose": "tsx src/index.ts",
    "quick": "tsx src/cli.ts --mode quick",
    "raw": "tsx src/cli.ts --mode raw",
    "improv": "tsx src/cli.ts --mode improv",
    "category": "tsx src/cli.ts --mode category",
    "save": "tsx src/save-to-site.ts",
    "storage:stats": "tsx src/storage/cli.ts stats",
    "storage:cleanup": "tsx src/storage/cli.ts cleanup"
  },
  "dependencies": {
    "@mastra/core": "latest",
    "chalk": "^5.3.0",
    "ioredis": "^5.4.0",
    "ora": "^8.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
