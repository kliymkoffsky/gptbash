{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["import", "promise", "jsx-a11y"],
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "globals": {
    "astroHTML": "readonly"
  },
  "ignorePatterns": [
    "node_modules",
    "dist",
    ".astro",
    ".sonda",
    "*.json"
  ],
  "rules": {
    "no-unused-vars": "warn",
    "no-console": "off",
    "eqeqeq": "warn",
    "no-var": "error",
    "prefer-const": "warn",
    "import/no-duplicates": "warn",
    "import/no-self-import": "error",
    "promise/no-return-wrap": "warn"
  }
}
