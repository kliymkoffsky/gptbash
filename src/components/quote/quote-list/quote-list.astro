---
import QuoteCardAstro from '../quote-card/quote-card.astro';
import Pagination from '../../ui/pagination/pagination';
import { LOADER_TEXT } from '../../ui/loader-status/loader-status';

interface Quote {
  uuid: string;
  id: number;
  content: string;
  date: string;
  upvotes: number;
  downvotes: number;
}

interface Props {
  quotes: Quote[];
  currentPage?: number;
  totalPages?: number;
  baseUrl?: string;
  enableInfiniteScroll?: boolean;
}

const { 
  quotes, 
  currentPage = 1, 
  totalPages = 1,
  baseUrl = '',
  enableInfiniteScroll = false,
} = Astro.props;
---

<div>
  {/* Top pagination */}
  {totalPages > 1 && (
    <Pagination 
      currentPage={currentPage} 
      totalPages={totalPages} 
      baseUrl={baseUrl}
      client:load
    />
  )}
  
  {/* Server-rendered quotes with inlined styles */}
  {quotes.map((quote) => (
    <QuoteCardAstro key={quote.uuid} quote={quote} />
  ))}

  {/* Infinite scroll loader - only if enabled */}
  {enableInfiniteScroll && (
    <div 
      id="infinite-scroll-loader" 
      data-base-url={baseUrl}
      data-current-page={currentPage}
      data-total-pages={totalPages}
      data-text-loading={LOADER_TEXT.loading}
      data-text-end={LOADER_TEXT.endOfList}
      data-text-retry={LOADER_TEXT.retry}
      style="margin: 10px 16px; color: #666; font-size: 12px;"
    >
      <span>{LOADER_TEXT.loading}</span>
      <div data-sentinel style="height: 1px;"></div>
    </div>
  )}
  
  {/* Bottom pagination - only if no infinite scroll */}
  {!enableInfiniteScroll && totalPages > 1 && (
    <Pagination 
      currentPage={currentPage} 
      totalPages={totalPages} 
      baseUrl={baseUrl}
      client:load
    />
  )}
</div>

{enableInfiniteScroll && (
  <script>
    // Infinite scroll implementation
    const loader = document.getElementById('infinite-scroll-loader');
    const sentinel = loader?.querySelector('[data-sentinel]') as HTMLElement;
    
    if (loader && sentinel) {
      let loading = false;
      let nextPage = parseInt(loader.dataset.currentPage || '1', 10) + 1;
      const totalPages = parseInt(loader.dataset.totalPages || '1', 10);
      const baseUrl = loader.dataset.baseUrl || '';
      
      // Text constants from data attributes (sourced from shared LOADER_TEXT)
      const TEXT = {
        loading: loader.dataset.textLoading || 'Loading…',
        end: loader.dataset.textEnd || "That's all.",
        retry: loader.dataset.textRetry || 'try again',
      };
      
      const html = {
        loading: () => `<span>${TEXT.loading}</span>`,
        loadingWithSentinel: () => `<span>${TEXT.loading}</span><div data-sentinel style="height: 1px;"></div>`,
        end: () => `<span>${TEXT.end}</span>`,
        error: (msg: string) => `<span>Loading error: ${msg} <a href="#" data-retry>${TEXT.retry}</a></span>`,
      };
      
      const observer = new IntersectionObserver(
        (entries) => {
          const entry = entries[0];
          if (!entry?.isIntersecting) return;
          if (loading) return;
          if (nextPage > totalPages) {
            loader.innerHTML = html.end();
            observer.disconnect();
            return;
          }

          const url = nextPage <= 1 ? `${baseUrl}.json` : `${baseUrl}/${nextPage}.json`;
          
          loading = true;
          loader.innerHTML = html.loading();

          fetch(url)
            .then(async (res) => {
              if (!res.ok) throw new Error(`HTTP ${res.status}`);
              return await res.json();
            })
            .then((data) => {
              // Insert new quote cards before the loader
              const container = loader.parentElement;
              if (container && data.quotes) {
                data.quotes.forEach((quote: any) => {
                  const article = createQuoteCard(quote);
                  container.insertBefore(article, loader);
                });
              }
              
              nextPage++;
              loading = false;
              
              if (nextPage > totalPages) {
                loader.innerHTML = html.end();
                observer.disconnect();
              } else {
                loader.innerHTML = html.loadingWithSentinel();
                const newSentinel = loader.querySelector('[data-sentinel]') as HTMLElement;
                if (newSentinel) {
                  observer.observe(newSentinel);
                }
              }
            })
            .catch((err) => {
              loading = false;
              loader.innerHTML = html.error(err.message);
              const retryBtn = loader.querySelector('[data-retry]');
              if (retryBtn) {
                retryBtn.addEventListener('click', (e) => {
                  e.preventDefault();
                  loader.innerHTML = html.loadingWithSentinel();
                  const newSentinel = loader.querySelector('[data-sentinel]') as HTMLElement;
                  if (newSentinel) observer.observe(newSentinel);
                });
              }
            });
        },
        { rootMargin: '600px 0px' }
      );

      observer.observe(sentinel);
    }

    // Helper to create quote card HTML (mirrors Astro component structure)
    function createQuoteCard(quote: any): HTMLElement {
      const article = document.createElement('article');
      
      function normalizeContentForDisplay(content: string): string {
        // Normalize newlines
        let out = String(content ?? '')
          .replace(/\\r\\n/g, '\n')
          .replace(/\\n/g, '\n')
          .replace(/\r\n/g, '\n');
        // Drop lines that are just a middle-dot separator
        out = out.replace(/^\s*·\s*$/gm, '');
        // Split inline "<nick>" segments onto new lines when surrounded by whitespace
        out = out.replace(/\s+(<[@+%&~]?[^\s<>]+>)\s+/g, '\n$1 ');
        // Trim line ends and reduce huge runs of empty lines
        out = out
          .split('\n')
          .map((l) => l.trimEnd())
          .filter((l, idx, arr) => {
            if (l.trim().length > 0) return true;
            const prev = arr[idx - 1];
            return prev?.trim().length > 0;
          })
          .join('\n')
          .trim();
        return out.length > 0 ? out : String(content ?? '');
      }

      // Escape HTML in content to prevent <nick> being interpreted as tags
      const normalizedContent = normalizeContentForDisplay(quote.content);
      const escapedContent = normalizedContent
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
      
      article.innerHTML = `
        <div class="bar clearfix">
          <span class="qid">
            <a href="/${quote.id}/" data-quote-id="${quote.id}">#${quote.id}</a>
          </span>
          <span class="votes">
            <button type="button" disabled>+</button>
          </span>
          <span class="votes">
            <button type="button" disabled>-</button>
          </span>
          <span class="points">${quote.upvotes - quote.downvotes}</span>
          <time class="date" datetime="${quote.date}">
            ${formatDate(quote.date)}
          </time>
        </div>
        <div class="quote">${escapedContent}</div>
      `;
      return article;
    }

    function formatDate(dateStr: string): string {
      const date = new Date(dateStr);
      const months = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
      return `${months[date.getMonth()]} ${date.getDate()}, ${date.getFullYear()}`;
    }
  </script>
)}
