---
import './footer.css';
import quotesData from '../data/quotes.json';
import { formatNumber } from '../utils/formatters';

// Calculate real stats from the data
const totalQuotes = quotesData.quotes.length;
const totalRejected = quotesData.meta.totalRejected;
---

<footer id="foot">
  <strong>{formatNumber(totalQuotes)}</strong> accepted quotes,
  <strong>{formatNumber(totalRejected)}</strong> rejected,
  <a href="/privacy/">privacy policy</a>
</footer>
