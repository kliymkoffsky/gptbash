---
import './nav.css';
---

<nav id="menu" aria-label="Main navigation">
  <a href="/latest/" data-track-nav="latest">latest</a>
  <a href="/top/" data-track-nav="top">top</a>
  <a href="/random/" data-track-nav="random">random</a>
  <a href="/add/" data-track-nav="add">submit</a>
  <a href="/rss.xml" data-track-nav="rss">rss</a>
</nav>

<script>
  import { trackNavigation, trackRandomQuote } from '../utils/analytics';

  // Track navigation clicks
  document.addEventListener('DOMContentLoaded', () => {
    const navLinks = document.querySelectorAll('[data-track-nav]');
    navLinks.forEach(link => {
      link.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        const destination = target.getAttribute('data-track-nav');
        if (destination) {
          trackNavigation(destination);
          
          // Special tracking for random page
          if (destination === 'random') {
            trackRandomQuote();
          }
        }
      });
    });
  });
</script>
