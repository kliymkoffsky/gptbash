---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;

import quotesData from '../data/quotes.json';

// Calculate real stats from the data
const totalQuotes = quotesData.quotes.length;
const totalRejected = quotesData.meta.totalRejected;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" href="/rss.xml" title="bash.org.pl RSS" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <!-- Header -->
    <h1 id="head">
      <a href="/">bash.org.pl</a>
    </h1>

    <!-- Main wrapper with white background -->
    <div id="main">
      <!-- Navigation Menu - positioned top right like original -->
      <div id="menu">
        <a href="/latest/">najnowsze</a>
        <a href="/top/">top</a>
        <a href="/random/">losowe</a>
        <a href="/add/">dodaj</a>
        <a href="/rss.xml">rss</a>
      </div>

      <!-- Content -->
      <div id="content">
        <slot />
      </div>
    </div>

    <!-- Footer with real stats -->
    <div id="foot">
      <strong>{totalQuotes.toLocaleString('pl-PL')}</strong> zaakceptowanych cytatów, 
      <strong>{totalRejected.toLocaleString('pl-PL')}</strong> odpadło, 
      <a href="/privacy/">polityka prywatności</a>
    </div>
  </body>
</html>
