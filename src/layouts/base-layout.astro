---
import '../styles/global.css';
import Header from '../components/header.astro';
import Nav from '../components/nav.astro';
import Footer from '../components/footer.astro';
import SeoHead from '../components/seo-head.astro';
import StructuredData from '../components/structured-data.astro';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  type?: 'website' | 'article';
  image?: string;
  publishedTime?: string;
  includeWebsiteSchema?: boolean;
}

const { 
  title, 
  description, 
  canonical, 
  type, 
  image, 
  publishedTime,
  includeWebsiteSchema = true 
} = Astro.props;

const currentUrl = canonical || new URL(Astro.url.pathname, Astro.site || 'https://gptbash.com').href;
const defaultDescription = 'Funny IRC quotes - gptbash.com';
const pageDescription = description || defaultDescription;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" href="/rss.xml" title="gptbash.com RSS" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    
    <SeoHead 
      title={title}
      description={pageDescription}
      canonical={currentUrl}
      type={type}
      image={image}
      publishedTime={publishedTime}
    />
    
    {includeWebsiteSchema && (
      <StructuredData 
        schema={{
          type: 'WebSite',
          name: 'gptbash.com',
          url: 'https://gptbash.com/',
          description: 'Funny IRC quotes — the largest collection of Polish IRC conversation quotes'
        }}
      />
    )}
    
    <slot name="structured-data" />
  </head>
  <body>
    <a href="#content" class="skip-link">Skip to content</a>
    
    <Header />

    <!-- Main wrapper with white background -->
    <main id="main">
      <Nav />

      <!-- Content -->
      <div id="content">
        <slot />
      </div>
    </main>

    <Footer />
  </body>
</html>
