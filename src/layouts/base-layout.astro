---
import '../styles/global.css';
import Header from '../components/layout/header/header.astro';
import Nav from '../components/layout/nav/nav.astro';
import Footer from '../components/layout/footer/footer.astro';
import SeoHead from '../components/seo/seo-head.astro';
import StructuredData from '../components/seo/structured-data.astro';
import site from '../data/site.json';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  type?: 'website' | 'article';
  image?: string;
  publishedTime?: string;
  includeWebsiteSchema?: boolean;
}

const { 
  title, 
  description, 
  canonical, 
  type, 
  image, 
  publishedTime,
  includeWebsiteSchema = true 
} = Astro.props;

const currentUrl = canonical || new URL(Astro.url.pathname, Astro.site || site.baseUrl).href;
const defaultDescription = `${site.tagline} - ${site.name}`;
const pageDescription = description || defaultDescription;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" href="/rss.xml" title={`${site.name} RSS`} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    
    <SeoHead 
      title={title}
      description={pageDescription}
      canonical={currentUrl}
      type={type}
      image={image}
      publishedTime={publishedTime}
    />
    
    {includeWebsiteSchema && (
      <StructuredData 
        schema={{
          type: 'WebSite',
          name: site.name,
          url: `${site.baseUrl}/`,
          description: site.tagline
        }}
      />
    )}
    
    <slot name="structured-data" />
  </head>
  <body>
    <Header />
    <Nav />
    <main id="main">
      <div id="content">
        <slot />
      </div>
    </main>
    <Footer />
  </body>
</html>
