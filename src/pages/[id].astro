---
import BaseLayout from '../layouts/base-layout.astro';
import QuoteCard from '../components/quote-card';
import StructuredData from '../components/structured-data.astro';
import quotesData from '../data/quotes.json';

export function getStaticPaths() {
  return quotesData.quotes.map((quote) => ({
    params: { id: quote.id.toString() },
    props: { quote },
  }));
}

interface Props {
  quote: {
    uuid: string;
    id: number;
    content: string;
    date: string;
    upvotes: number;
    downvotes: number;
  };
}

const { quote } = Astro.props;

// Generate description from quote content (first 150 chars)
const descriptionText = quote.content.length > 150 
  ? quote.content.substring(0, 150) + '...' 
  : quote.content;

const pageUrl = `https://gptbash.com/${quote.id}/`;
const ogImageUrl = `https://gptbash.com/og-image/${quote.id}.webp`;
---

<BaseLayout 
  title={`gptbash.com: quote #${quote.id}`}
  description={descriptionText}
  canonical={pageUrl}
  type="article"
  image={ogImageUrl}
  publishedTime={quote.date}
  includeWebsiteSchema={false}
>
  <StructuredData 
    slot="structured-data"
    schema={{
      type: 'Article',
      headline: `Quote #${quote.id}`,
      description: descriptionText,
      datePublished: quote.date,
      url: pageUrl
    }}
  />
  
  <QuoteCard quote={quote} showLink={false} client:load />
  
  <p style="margin: 10px 17px; font-size: 12px;">
    <a href="/latest/">« latest</a> | 
    <a href="/top/">« top</a>
  </p>
</BaseLayout>

<script define:vars={{ quoteId: quote.id }}>
  // Track individual quote page view
  if (typeof window !== 'undefined' && window.gtag) {
    window.gtag('event', 'page_view', {
      page_title: `Quote #${quoteId}`,
      page_location: window.location.href,
      quote_id: quoteId,
    });
  }
</script>
