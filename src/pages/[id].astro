---
import BaseLayout from '../layouts/base-layout.astro';
import QuoteCard from '../components/quote-card';
import quotesData from '../data/quotes.json';

export function getStaticPaths() {
  return quotesData.quotes.map((quote) => ({
    params: { id: quote.id.toString() },
    props: { quote },
  }));
}

interface Props {
  quote: {
    uuid: string;
    id: number;
    content: string;
    date: string;
    upvotes: number;
    downvotes: number;
  };
}

const { quote } = Astro.props;
---

<BaseLayout title={`gptbash.com: cytat #${quote.id}`}>
  <QuoteCard quote={quote} showLink={false} client:load />
  
  <p style="margin: 10px 17px; font-size: 12px;">
    <a href="/latest/">« najnowsze</a> | 
    <a href="/top/">« top</a>
  </p>
</BaseLayout>
