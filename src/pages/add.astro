---
import BaseLayout from '../layouts/base-layout.astro';
import site from '../data/site.json';
---

<BaseLayout 
  title={`${site.name}: submit a quote`}
  description={`Submit a new IRC quote to ${site.name}. Enter the conversation in the format <nick> message.`}
>
  <div class="add">
    <form id="addForm" aria-labelledby="form-title">
      <h2 id="form-title" style="margin: 10px 0 15px 0;">Submit a new quote</h2>
      
      <label for="quote" class="sr-only">Quote content</label>
      <textarea 
        id="quote" 
        name="quote" 
        rows="12"
        aria-required="true"
        aria-describedby="quote-instructions"
        placeholder="<nick> message"
        disabled
      ></textarea>

      <div id="error-message" role="alert" aria-live="assertive" style="display: none; color: #b33; margin: 10px 0;"></div>
      
      <div class="checkbox-row">
        <input type="checkbox" id="adult" name="adult" value="1" disabled /><br />
        <label for="adult">this quote contains adult content</label>
      </div>
      
      <input type="submit" value="submit quote" class="submit-btn" disabled />
    </form>

    <div id="result" role="status" aria-live="polite">
      <p>Copy and run this command in your terminal:</p>
      <pre id="command"></pre>
      <button id="copyBtn" class="submit-btn" style="margin-top: 10px; width: auto; padding: 5px 15px;">
        Copy
      </button>
    </div>
  </div>
</BaseLayout>

<script type="module">
  import { quoteInputToParsedSchema } from '../types/quote-format';
  import { trackQuoteSubmit, trackCommandCopy } from '../utils/analytics';

  const form = document.getElementById('addForm');
  const result = document.getElementById('result');
  const command = document.getElementById('command');
  const copyBtn = document.getElementById('copyBtn');
  const errorMessage = document.getElementById('error-message');
  const quoteTextarea = document.getElementById('quote');
  const adultCheckbox = document.getElementById('adult');
  const submitBtn = form?.querySelector('input[type="submit"]');
  
  // Enable form elements on load
  if (quoteTextarea instanceof HTMLTextAreaElement) quoteTextarea.disabled = false;
  if (adultCheckbox instanceof HTMLInputElement) adultCheckbox.disabled = false;
  if (submitBtn instanceof HTMLInputElement) submitBtn.disabled = false;
  
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    
    if (!(quoteTextarea instanceof HTMLTextAreaElement)) return;
    
    // Disable form elements during submission
    const setFormDisabled = (disabled) => {
      quoteTextarea.disabled = disabled;
      if (adultCheckbox instanceof HTMLInputElement) adultCheckbox.disabled = disabled;
      if (submitBtn instanceof HTMLInputElement) submitBtn.disabled = disabled;
    };
    
    setFormDisabled(true);
    
    // Clear previous error
    if (errorMessage) {
      errorMessage.style.display = 'none';
      errorMessage.textContent = '';
    }
    
    if (quoteTextarea instanceof HTMLTextAreaElement) {
      quoteTextarea.removeAttribute('aria-invalid');
    }

    const adult =
      adultCheckbox instanceof HTMLInputElement && adultCheckbox.type === 'checkbox'
        ? adultCheckbox.checked
        : false;

    const quote = quoteTextarea.value.trim();
    
    if (!quote) {
      if (errorMessage) {
        errorMessage.textContent = 'Enter quote content';
        errorMessage.style.display = 'block';
      }
      quoteTextarea.setAttribute('aria-invalid', 'true');
      setFormDisabled(false);
      quoteTextarea.focus();
      return;
    }

    const parsed = quoteInputToParsedSchema.safeParse({ content: quote, adult });
    if (!parsed.success) {
      // Zod errors are usually more specific than generic alerts
      const errorMsg = parsed.error.issues[0]?.message ?? 'Invalid quote format';
      if (errorMessage) {
        errorMessage.textContent = errorMsg;
        errorMessage.style.display = 'block';
      }
      quoteTextarea.setAttribute('aria-invalid', 'true');
      setFormDisabled(false);
      quoteTextarea.focus();
      return;
    }
    
    // Escape quotes for shell
    const escaped = quote
      .replace(/\\/g, '\\\\')
      .replace(/"/g, '\\"')
      .replace(/\$/g, '\\$')
      .replace(/`/g, '\\`');
    
    const cmd = `npm run add-quote "${escaped}"`;
    
    // Track successful form submission
    trackQuoteSubmit(adult);
    
    if (command && result) {
      command.textContent = cmd;
      result.style.display = 'block';
      result.scrollIntoView({ behavior: 'smooth' });
    }
    
    // Keep form disabled after successful submission
  });
  
  copyBtn?.addEventListener('click', () => {
    const cmd = command?.textContent;
    if (cmd) {
      navigator.clipboard.writeText(cmd).then(() => {
        // Track copy action
        trackCommandCopy();
        
        if (copyBtn) {
          copyBtn.textContent = 'Copied!';
          setTimeout(() => {
            copyBtn.textContent = 'Copy';
          }, 2000);
        }
      });
    }
  });
</script>

<style>
  .add {
    text-align: center;
    padding: 0 15px;
    contain: layout style;
  }
  
  .add form {
    max-width: 900px;
    margin: 0 auto;
  }
  
  .add textarea {
    width: 98%;
    font-family: "Lucida Console", "Droid Sans Mono", Monaco, monospace;
    font-size: 13px;
    padding: 8px;
    border: 1px solid #aaa;
    resize: vertical;
    /* Prevent layout shift on focus */
    transform: translateZ(0);
  }
  
  .add textarea:focus {
    outline: none;
    border-color: #666;
  }
  
  .checkbox-row {
    margin: 10px 0 20px 0;
    text-align: center;
  }
  
  .checkbox-row input {
    margin-bottom: 5px;
  }
  
  .checkbox-row label {
    color: #555;
    font-size: 13px;
  }
  
  .submit-btn {
    display: block;
    width: 100%;
    max-width: 900px;
    margin: 0 auto;
    padding: 2px 20px;
    background: #565d5f;
    border: 1px solid #ccc;
    color: #ccc;
    font-size: 13px;
    cursor: pointer;
    line-height: 1.4;
    /* Prevent layout shift on hover */
    transform: translateZ(0);
  }
  
  .submit-btn:hover:not(:disabled) {
    opacity: 0.9;
    will-change: opacity;
  }
  
  .submit-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }
  
  .add textarea:disabled,
  .add input:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    background: #eee;
  }
  
  #result {
    display: none;
    max-width: 900px;
    margin: 20px auto;
    padding: 15px;
    background: #f4f4f4;
    border: 1px solid #cfd1d1;
    text-align: left;
    /* Prevent layout shift when shown */
    contain: layout style;
  }
  
  #result p {
    margin: 0 0 10px 0;
    font-size: 12px;
    color: #666;
  }
  
  #result pre {
    background: #333;
    color: #0f0;
    padding: 10px;
    overflow-x: auto;
    font-size: 12px;
    font-family: "Lucida Console", monospace;
    margin: 0;
  }
  
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }
</style>
