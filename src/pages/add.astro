---
import BaseLayout from '../layouts/base-layout.astro';
---

<BaseLayout 
  title="gptbash.com: dodaj cytat"
  description="Dodaj nowy cytat IRC do bazy gptbash.com. Wprowadź rozmowę w formacie <nick> wiadomość."
>
  <div class="add">
    <form id="addForm" aria-labelledby="form-title">
      <h2 id="form-title" style="margin: 10px 0 15px 0;">Dodaj nowy cytat</h2>
      
      <label for="quote" class="sr-only">Treść cytatu</label>
      <textarea 
        id="quote" 
        name="quote" 
        rows="12"
        aria-required="true"
        aria-describedby="quote-instructions"
        placeholder="<nick> wiadomość"
      ></textarea>
      
      <p id="quote-instructions" style="font-size: 12px; color: #666; margin: 5px 0;">
        Format: &lt;nick&gt; wiadomość (każda linia to nowa wiadomość)
      </p>
      
      <div id="error-message" role="alert" aria-live="assertive" style="display: none; color: #b33; margin: 10px 0;"></div>
      
      <div class="checkbox-row">
        <input type="checkbox" id="adult" name="adult" value="1" /><br />
        <label for="adult">cytat zawiera treści przeznaczone dla dorosłych odbiorców</label>
      </div>
      
      <input type="submit" value="dodaj cytat" class="submit-btn" />
    </form>

    <div id="result" role="status" aria-live="polite">
      <p>Skopiuj i uruchom komendę w terminalu:</p>
      <pre id="command"></pre>
      <button id="copyBtn" class="submit-btn" style="margin-top: 10px; width: auto; padding: 5px 15px;">
        Kopiuj
      </button>
    </div>
  </div>
</BaseLayout>

<script type="module">
  import { quoteInputToParsedSchema } from '../types/quote-format';
  import { trackQuoteSubmit, trackCommandCopy } from '../utils/analytics';

  const form = document.getElementById('addForm');
  const result = document.getElementById('result');
  const command = document.getElementById('command');
  const copyBtn = document.getElementById('copyBtn');
  const errorMessage = document.getElementById('error-message');
  const quoteTextarea = document.getElementById('quote');
  
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    
    // Clear previous error
    if (errorMessage) {
      errorMessage.style.display = 'none';
      errorMessage.textContent = '';
    }
    
    if (quoteTextarea instanceof HTMLTextAreaElement) {
      quoteTextarea.removeAttribute('aria-invalid');
    }
    
    const textareaEl = document.getElementById('quote');
    if (!(textareaEl instanceof HTMLTextAreaElement)) return;

    const adultEl = document.getElementById('adult');
    const adult =
      adultEl instanceof HTMLInputElement && adultEl.type === 'checkbox'
        ? adultEl.checked
        : false;

    const quote = textareaEl.value.trim();
    
    if (!quote) {
      if (errorMessage) {
        errorMessage.textContent = 'Wprowadź treść cytatu';
        errorMessage.style.display = 'block';
      }
      textareaEl.setAttribute('aria-invalid', 'true');
      textareaEl.focus();
      return;
    }

    const parsed = quoteInputToParsedSchema.safeParse({ content: quote, adult });
    if (!parsed.success) {
      // Zod errors are usually more specific than generic alerts
      const errorMsg = parsed.error.issues[0]?.message ?? 'Nieprawidłowy format cytatu';
      if (errorMessage) {
        errorMessage.textContent = errorMsg;
        errorMessage.style.display = 'block';
      }
      textareaEl.setAttribute('aria-invalid', 'true');
      textareaEl.focus();
      return;
    }
    
    // Escape quotes for shell
    const escaped = quote
      .replace(/\\/g, '\\\\')
      .replace(/"/g, '\\"')
      .replace(/\$/g, '\\$')
      .replace(/`/g, '\\`');
    
    const cmd = `npm run add-quote "${escaped}"`;
    
    // Track successful form submission
    trackQuoteSubmit(adult);
    
    if (command && result) {
      command.textContent = cmd;
      result.style.display = 'block';
      result.scrollIntoView({ behavior: 'smooth' });
    }
  });
  
  copyBtn?.addEventListener('click', () => {
    const cmd = command?.textContent;
    if (cmd) {
      navigator.clipboard.writeText(cmd).then(() => {
        // Track copy action
        trackCommandCopy();
        
        if (copyBtn) {
          copyBtn.textContent = 'Skopiowano!';
          setTimeout(() => {
            copyBtn.textContent = 'Kopiuj';
          }, 2000);
        }
      });
    }
  });
</script>

<style>
  .add {
    text-align: center;
    padding: 0 15px;
  }
  
  .add form {
    max-width: 900px;
    margin: 0 auto;
  }
  
  .add textarea {
    width: 98%;
    font-family: "Lucida Console", "Droid Sans Mono", Monaco, monospace;
    font-size: 13px;
    padding: 8px;
    border: 1px solid #aaa;
    resize: vertical;
  }
  
  .add textarea:focus {
    outline: none;
    border-color: #666;
  }
  
  .checkbox-row {
    margin: 10px 0 20px 0;
    text-align: center;
  }
  
  .checkbox-row input {
    margin-bottom: 5px;
  }
  
  .checkbox-row label {
    color: #555;
    font-size: 13px;
  }
  
  .submit-btn {
    display: block;
    width: 100%;
    max-width: 900px;
    margin: 0 auto;
    padding: 2px 20px;
    background: #565d5f;
    border: 1px solid #ccc;
    color: #ccc;
    font-size: 13px;
    cursor: pointer;
    line-height: 1.4;
  }
  
  .submit-btn:hover {
    opacity: 0.9;
  }
  
  #result {
    display: none;
    max-width: 900px;
    margin: 20px auto;
    padding: 15px;
    background: #f4f4f4;
    border: 1px solid #cfd1d1;
    text-align: left;
  }
  
  #result p {
    margin: 0 0 10px 0;
    font-size: 12px;
    color: #666;
  }
  
  #result pre {
    background: #333;
    color: #0f0;
    padding: 10px;
    overflow-x: auto;
    font-size: 12px;
    font-family: "Lucida Console", monospace;
    margin: 0;
  }
  
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }
</style>
