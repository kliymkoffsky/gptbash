---
import BaseLayout from '../layouts/BaseLayout.astro';
import QuoteCard from '../components/QuoteCard';
import quotesData from '../data/quotes.json';

// Get a random quote at build time
const randomIndex = Math.floor(Math.random() * quotesData.quotes.length);
const randomQuote = quotesData.quotes[randomIndex];
---

<BaseLayout title={`bash.org.pl: cytat #${randomQuote.id}`}>
  <QuoteCard quote={randomQuote} client:load />
  
  <p style="margin: 10px 17px; font-size: 12px; color: #888;">
    (Cytat losowany podczas budowania strony)
  </p>
</BaseLayout>
