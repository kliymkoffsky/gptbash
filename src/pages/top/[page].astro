---
import BaseLayout from '../../layouts/base-layout.astro';
import QuoteList from '../../components/quote-list';
import quotesData from '../../data/quotes.json';

const QUOTES_PER_PAGE = 20;

// Sort quotes by score (upvotes - downvotes), highest first
const allQuotes = [...quotesData.quotes]
  .sort((a, b) => (b.upvotes - b.downvotes) - (a.upvotes - a.downvotes));

const totalPages = Math.ceil(allQuotes.length / QUOTES_PER_PAGE);

export function getStaticPaths() {
  const QUOTES_PER_PAGE = 20;
  const allQuotes = [...quotesData.quotes]
    .sort((a, b) => (b.upvotes - b.downvotes) - (a.upvotes - a.downvotes));
  
  const totalPages = Math.ceil(allQuotes.length / QUOTES_PER_PAGE);
  
  // Generate paths for pages 2 onwards (page 1 is handled by index.astro)
  return Array.from({ length: totalPages - 1 }, (_, i) => ({
    params: { page: String(i + 2) },
  }));
}

const { page } = Astro.params;
const currentPage = parseInt(page);

// Get quotes for current page
const startIndex = (currentPage - 1) * QUOTES_PER_PAGE;
const topQuotes = allQuotes.slice(startIndex, startIndex + QUOTES_PER_PAGE);
---

<BaseLayout title={`gptbash.com: top - strona ${currentPage}`}>
  <QuoteList 
    quotes={topQuotes} 
    currentPage={currentPage}
    totalPages={totalPages}
    baseUrl="/top"
    enableInfiniteScroll={true}
    client:load 
  />
</BaseLayout>
