---
import BaseLayout from '../../layouts/base-layout.astro';
import QuoteList from '../../components/quote/quote-list/quote-list.astro';
import quotesData from '../../data/quotes.json';
import site from '../../data/site.json';

const QUOTES_PER_PAGE = 20;

// Sort quotes by score (upvotes - downvotes), highest first
const allQuotes = [...quotesData.quotes]
  .sort((a, b) => (b.upvotes - b.downvotes) - (a.upvotes - a.downvotes));

const totalPages = Math.ceil(allQuotes.length / QUOTES_PER_PAGE);
const currentPage = 1;

// Get quotes for page 1
const topQuotes = allQuotes.slice(0, QUOTES_PER_PAGE);
---

<BaseLayout 
  title={`${site.name}: top`}
  description="Top funny IRC quotes — highest-rated conversations. See the most popular quotes!"
  canonical={`${site.baseUrl}/top/`}
>
  <QuoteList 
    quotes={topQuotes} 
    currentPage={currentPage}
    totalPages={totalPages}
    baseUrl="/top"
    enableInfiniteScroll={true}
  />
</BaseLayout>
